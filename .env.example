# Server-only. Never prefix these with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://COACHOS_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coachos
APP_URL=https://YOUR_PROJECT.vercel.app
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=REPLACE_WITH_YOUR_RANDOM_SECRET
# Optional: required only for password reset emails; use a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM=coachOS <accounts@YOUR_DOMAIN.com>
